diff --git a/ui/widgets/buttons.cpp b/ui/widgets/buttons.cpp
--- a/ui/widgets/buttons.cpp
+++ b/ui/widgets/buttons.cpp
@@ -20,1 +20,2 @@
 #include <QtGui/QtEvents>
+#include <QtGui/QPainterPath>
@@ -979,12 +979,22 @@
 	const auto paintOver = (isOver() || isDown()) && !isDisabled();
 	paintBg(p, e->rect(), paintOver);
 
+	const auto rounded = (_st.radius > 0);
+	if (rounded) {
+		auto clip = QPainterPath();
+		clip.addRoundedRect(rect(), _st.radius, _st.radius);
+		p.save();
+		p.setClipPath(clip);
+	}
 	paintRipple(p, 0, 0);
+	if (rounded) {
+		p.restore();
+	}
 
 	const auto outerw = width();
 	paintText(p, paintOver, outerw);
 
 	if (_toggle) {
 		paintToggle(p, outerw);
 	}
 }
@@ -992,3 +992,12 @@
 void SettingsButton::paintBg(Painter &p, const QRect &rect, bool over) const {
-	p.fillRect(rect, over ? _st.textBgOver : _st.textBg);
+	const auto color = over ? _st.textBgOver : _st.textBg;
+	if (_st.radius <= 0) {
+		p.fillRect(rect, color);
+		return;
+	}
+	p.save();
+	p.setPen(Qt::NoPen);
+	p.setBrush(color);
+	p.drawRoundedRect(rect, _st.radius, _st.radius);
+	p.restore();
 }

